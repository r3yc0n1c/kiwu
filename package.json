{
  "name": "kiwu",
  "version": "1.0.0",
  "private": true,
  "description": "Your privacy-first Second Brain app",
  "keywords": [
    "AI",
    "PARA",
    "second-brain"
  ],
  "license": "ISC",
  "author": "Raja Majumdar (aka r3yc0n1c)",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm -r --if-present run dev",
    "build": "pnpm -r --if-present run build",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "db:generate:dev": "pnpm --filter @kiwu/db generate:dev",
    "db:generate:prod": "pnpm --filter @kiwu/db generate:prod",
    "db:generate:test": "pnpm --filter @kiwu/db generate:test",
    "db:push:dev": "pnpm --filter @kiwu/db push:dev",
    "db:push:prod": "pnpm --filter @kiwu/db push:prod",
    "db:push:test": "pnpm --filter @kiwu/db push:test",
    "check": "pnpm lint:fix && pnpm format && pnpm typecheck"
  },
  "devDependencies": {
    "@types/node": "catalog:dev",
    "fastify": "catalog:http",
    "ioredis": "catalog:cache",
    "oxfmt": "catalog:dev",
    "oxlint": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "packageManager": "pnpm@12.6.0"
}
